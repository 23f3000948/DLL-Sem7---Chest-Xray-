95086Z","iopub.execute_input":"2026-03-22T16:17:09.995761Z","iopub.status.idle":"2026-03-22T16:17:10.598806Z","shell.execute_reply.started":"2026-03-22T16:17:09.99573Z","shell.execute_reply":"2026-03-22T16:17:10.598002Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import numpy as np\n\ndef calculate_competition_score(probabilities, labels):\n\n    best_guess_indices = np.argmax(probabilities, axis=1)\n    \n    # 2. Create a blank array of 0s\n    preds = np.zeros_like(probabilities, dtype=int)\n    \n    # 3. Place exactly one '1' in each row based on the model's top choice\n    for row_idx in range(len(preds)):\n        winning_col_idx = best_guess_indices[row_idx]\n        preds[row_idx, winning_col_idx] = 1\n        \n    labels = labels.astype(int)\n    num_classes = labels.shape[1]\n    class_scores = []\n    \n    for c in range(num_classes):\n        p = preds[:, c]\n        t = labels[:, c]\n        \n        TP = np.sum((p == 1) & (t == 1))\n        FP = np.sum((p == 1) & (t == 0))\n        FN = np.sum((p == 0) & (t == 1))\n        \n        N = TP + FN # Total actual positive cases\n        \n        if N > 0: \n            score = (TP - FP - 5 * FN) / N\n            class_scores.append(score)\n            \n    return np.mean(class_scores) if class_scores else 0.0","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-22T16:17:14.629984Z","iopub.execute_input":"2026-03-22T16:17:14.630745Z","iopub.status.idle":"2026-03-22T16:17:14.637183Z","shell.execute_reply.started":"2026-03-22T16:17:14.630698Z","shell.execute_reply":"2026-03-22T16:17:14.636301Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from tqdm import tqdm\n\n\nnum_epochs = 7 \n\nfor epoch in range(num_epochs):\n    print(f\"\\n--- Epoch {epoch+1}/{num_epochs} ---\")\n\n    densenet121.train() \n    train_loss = 0.0\n    \n\n    progress_bar = tqdm(train_loader, desc=\"Training\")\n    \n    for images, labels in progress_bar:\n     